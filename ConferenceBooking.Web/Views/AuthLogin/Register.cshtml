@model ConferenceBooking.Web.Models.AuthLogin.RegistrationRequestDto

@{
    Layout = null;
    ViewData["Title"] = "Register | CONVENE";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register | CONVENE</title>

    <link href="~/assets/vendor.min.css" rel="stylesheet" />
    <link href="~/assets/app.min.css" rel="stylesheet" />
    <link href="~/assets/icons.min.css" rel="stylesheet" />
</head>

<body>
    <div class="auth-bg d-flex min-vh-100 justify-content-center align-items-center">
        <div class="row g-0 justify-content-center w-100 m-3">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="card overflow-hidden text-center p-4 mb-0">

                    <a asp-controller="AuthLogin"
                       asp-action="Login"
                       class="auth-brand mb-3">
                        <img src="~/images/ConveneDarkLogoIndia.png"
                             alt="CONVENE"
                             height="85" />
                    </a>

                    <h2 class="fw-semibold mb-1">Create your account</h2>
                    <p class="text-muted mb-4">
                        Submit your details for Administrator approval.
                    </p>

                    <form asp-controller="AuthLogin"
                          asp-action="Register"
                          method="post"
                          class="text-start">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label"></label>
                            <input asp-for="DisplayName" class="form-control"
                                   autocomplete="name" />
                            <span asp-validation-for="DisplayName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Designation" class="form-label"></label>
                            <input asp-for="Designation" class="form-control" />
                            <span asp-validation-for="Designation"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control"
                                   type="email" autocomplete="email" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                            <small class="text-muted">
                                Your username will be derived from your email address.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MobileNumber" class="form-label"></label>
                            <input asp-for="MobileNumber" class="form-control"
                                   type="tel" autocomplete="tel" />
                            <span asp-validation-for="MobileNumber"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DeskPhone" class="form-label"></label>
                            <input asp-for="DeskPhone" class="form-control"
                                   type="tel" />
                            <span asp-validation-for="DeskPhone"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword"
                                   class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">
                                Submit registration
                            </button>
                        </div>
                    </form>

                    <p class="mt-3 mb-0">
                        Already registered?
                        <a asp-controller="AuthLogin" asp-action="Login">
                            Sign in
                        </a>
                    </p>

                    <p class="text-muted small mt-4 mb-0">
                        Developed by Software Development Cell, MAC, New Delhi.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/vendor.min.js"></script>
    <script src="~/assets/app.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>

@{
    Layout = null;
    ViewData["Title"] = "Verify OTP";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Verify OTP | CONVENE</title>

    <link href="~/assets/vendor.min.css" rel="stylesheet" />
    <link href="~/assets/app.min.css" rel="stylesheet" />
    <link href="~/assets/icons.min.css" rel="stylesheet" />

    <style>
        .otp-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 25px 0;
        }

        .otp-box {
            width: 48px;
            height: 55px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            color: #243b64;
            outline: none;
            transition: all 0.2s ease;
        }

        .otp-box:focus {
            border-color: #3159a5;
            box-shadow: 0 0 0 3px rgba(49, 89, 165, 0.15);
        }

        .otp-box.is-invalid {
            border-color: #dc3545;
        }

        @@media (max-width: 400px) {
            .otp-container {
                gap: 6px;
            }

            .otp-box {
                width: 42px;
                height: 50px;
            }
        }
    </style>
</head>

<body>
    <div class="auth-bg d-flex min-vh-100 justify-content-center align-items-center">

        <div class="col-xl-4 col-lg-5 col-md-6 m-3">

            <div class="card text-center p-4">

                <a asp-controller="AuthLogin"
                   asp-action="Login"
                   class="auth-brand mb-3">

                    <img src="~/images/ConveneDarkLogoIndia.png"
                         height="90"
                         alt="CONVENE" />
                </a>

                <h3 class="fw-semibold mb-2">
                    Verify OTP
                </h3>

                <p class="text-muted">
                    Enter the six-digit verification code sent to your registered email address.
                </p>

                <div class="alert alert-info text-start">
                    <i class="ti ti-mail me-1"></i>
                    Your OTP is valid for 5 minutes.
                </div>

                @if (TempData["success"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @TempData["success"]
                    </div>
                }

                <form asp-action="VerifyOtp"
                      method="post"
                      id="verifyOtpForm"
                      class="text-start">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger mb-3"></div>

                    <input type="hidden"
                           name="email"
                           value="@ViewBag.Email" />

                    <div class="mb-3">
                        <label class="form-label">
                            Email Address
                        </label>

                        <input type="email"
                               class="form-control"
                               value="@ViewBag.Email"
                               readonly />
                    </div>

                    <label class="form-label">
                        One-Time Password
                    </label>

                    <div class="otp-container" id="otpContainer">

                        @for (int i = 0; i < 6; i++)
                        {
                            <input type="text"
                                   class="otp-box"
                                   maxlength="1"
                                   inputmode="numeric"
                                   pattern="[0-9]"
                                   autocomplete="one-time-code"
                                   aria-label="OTP digit @(i + 1)"
                                   required />
                        }

                    </div>

                    <input type="hidden"
                           id="otp"
                           name="otp" />

                    <div id="otpError"
                         class="text-danger text-center mb-3"
                         style="display:none;">
                        Please enter all six numeric digits.
                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Verify OTP
                        </button>
                    </div>

                </form>

                <div class="mt-3">
                    <a asp-action="ForgotPassword">
                        Request a new OTP
                    </a>
                </div>

                <div class="mt-3">
                    <a asp-action="Login"
                       class="text-muted">
                        Back to Login
                    </a>
                </div>

            </div>
        </div>
    </div>

    <script src="~/assets/vendor.min.js"></script>
    <script src="~/assets/app.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const boxes = Array.from(
                document.querySelectorAll(".otp-box")
            );

            const hiddenOtp = document.getElementById("otp");
            const form = document.getElementById("verifyOtpForm");
            const error = document.getElementById("otpError");

            function getOtp() {
                return boxes.map(box => box.value).join("");
            }

            function updateOtp() {
                hiddenOtp.value = getOtp();
            }

            function clearError() {
                error.style.display = "none";

                boxes.forEach(box =>
                    box.classList.remove("is-invalid")
                );
            }

            boxes.forEach((box, index) => {

                box.addEventListener("input", function () {

                    // Accept numeric characters only.
                    const digits = this.value.replace(/[^0-9]/g, "");

                    this.value = digits.slice(-1);

                    clearError();
                    updateOtp();

                    if (this.value && index < boxes.length - 1) {
                        boxes[index + 1].focus();
                    }
                });

                box.addEventListener("keydown", function (e) {

                    if (e.key === "Backspace") {

                        if (!this.value && index > 0) {
                            boxes[index - 1].focus();
                            boxes[index - 1].value = "";
                        }

                        updateOtp();
                    }

                    if (e.key === "ArrowLeft" && index > 0) {
                        boxes[index - 1].focus();
                    }

                    if (e.key === "ArrowRight" && index < 5) {
                        boxes[index + 1].focus();
                    }
                });

                box.addEventListener("paste", function (e) {

                    e.preventDefault();

                    const pastedText =
                        (e.clipboardData || window.clipboardData)
                        .getData("text");

                    const digits =
                        pastedText.replace(/[^0-9]/g, "").slice(0, 6);

                    boxes.forEach((item, i) => {
                        item.value = digits[i] || "";
                    });

                    clearError();
                    updateOtp();

                    const nextEmpty = boxes.findIndex(
                        item => !item.value
                    );

                    if (nextEmpty >= 0) {
                        boxes[nextEmpty].focus();
                    } else {
                        boxes[5].focus();
                    }
                });

            });

            form.addEventListener("submit", function (e) {

                updateOtp();

                const otpValue = hiddenOtp.value;

                if (!/^[0-9]{6}$/.test(otpValue)) {

                    e.preventDefault();

                    error.style.display = "block";

                    boxes.forEach(box =>
                        box.classList.add("is-invalid")
                    );

                    const firstEmpty = boxes.findIndex(
                        box => !box.value
                    );

                    boxes[firstEmpty >= 0 ? firstEmpty : 0].focus();

                    return;
                }

            });

            boxes[0].focus();

        });
    </script>

</body>
</html>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>
        Access Denied | MAC Utility Services
    </title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description">
    <meta content="Coderthemes" name="author" />
    <!-- App favicon -->
    <link href="../assets/favicon.ico" rel="shortcut icon" />
    <!-- Theme Config Js -->
    <script src="../assets/config.js">
    </script>
    <!-- Vendor css -->
    <link href="../assets/vendor.min.css" rel="stylesheet" type="text/css">
    <!-- App css -->
    <link href="../assets/app.min.css" id="app-style" rel="stylesheet" type="text/css" />
    <!-- Icons css -->
    <link href="../assets/icons.min.css" rel="stylesheet" type="text/css" />
    </link>
    </meta>
</head>
<body class="h-100">
    <div class="auth-bg d-flex min-vh-100 justify-content-center align-items-center">
        <div class="row g-0 justify-content-center w-100 m-xxl-5 px-xxl-4 m-3">
            <div class="col-xxl-4 col-xl-4 col-lg-5 col-md-6">
                <div class="card overflow-hidden text-center h-100 p-xxl-4 p-3 mb-0">
                    <a class="auth-brand mb-3" href="home/index.html">
                        <img alt="dark logo" class="logo-dark" height="70" src="../assets/logo-dark.png">
                        <img alt="logo light" class="logo-light" height="70" src="../assets/logo.png">
                    </a>
                    <div class="mx-auto text-center">
                        <h3 class="fw-semibold mb-2">
                            Hold Up !
                        </h3>
                        <img alt="" class="mt-3 mb-2" height="230" src="../assets/error-401.png" />
                        <h2 class="fw-bold mt-3 text-primary lh-base">
                            Error Unauthorized !
                        </h2>
                        <h4 class="fw-bold mt-2 text-dark lh-base">
                            You are not authorized to view this page.
                        </h4>
                        <button class="btn btn-primary" onclick="history.go(-1)">
                            Back
                            <i class="ti ti-reload ms-1">
                            </i>
                        </button>
                    </div>
                    <p class="mt-3 mb-0">
                        <div class="text-center text-md-start">
                            <div class="container" style="text-align:center;color:midnightblue;font-weight:bold;text-shadow:2px 2px white">
                                Developed by Software Development Cell, MAC, New Delhi.<sup>&copy;</sup>
                                <br />This site is best viewed in Google Chrome
                            </div>
                        </div>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <!-- Vendor js -->
    <script src="../assets/vendor.min.js">
    </script>
    <!-- App js -->
    <script src="../assets/app.js">
    </script>
</body>
</html>

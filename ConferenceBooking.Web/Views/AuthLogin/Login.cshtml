@model ConferenceBooking.Web.Models.AuthLogin.LoginRequestDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>
            Log In | Convene - Conference and Meeting Management
        </title>
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description">
        <meta content="Coderthemes" name="author" />
        <!-- App favicon -->
        <link href="../assets/favicon.ico" rel="shortcut icon" />
        <!-- Theme Config Js -->
        <script src="../assets/config.js">
        </script>
        <!-- Vendor css -->
        <link href="../assets/vendor.min.css" rel="stylesheet" type="text/css">
        <!-- App css -->
        <link href="../assets/app.min.css" id="app-style" rel="stylesheet" type="text/css" />
        <!-- Icons css -->
        <link href="../assets/icons.min.css" rel="stylesheet" type="text/css" />
    </head>

    <body>
        <div class="auth-bg d-flex min-vh-100 justify-content-center align-items-center">
            <div class="row g-0 justify-content-center w-100 m-xxl-5 px-xxl-4 m-3">
                <div class="col-xl-4 col-lg-5 col-md-6">
                    <div class="card overflow-hidden text-center h-100 p-xxl-4 p-3 mb-0">
                        <a class="auth-brand mb-3" asp-controller="AuthLogin" asp-action="Login">
                        <img alt="dark logo" class="logo-dark" height="100" src="../assets/ConveneDarkLogoIndia.png" />
                        <img alt="logo light" class="logo-light" height="100" src="../assets/ConveneLightLogoIndia.png" />
                        </a>
                        <h1 class="fw-semibold mb-2">
                            Convene
                        </h1>
@*                         <p class="fs-13 fw-semibold">
                            Click here
                        </p>
                        <div class="d-flex justify-content-center gap-2 mb-3">
                            <a asp-controller="AuthLogin" asp-action="LoginBySSO" asp-route-username="@TempData["LdapUser"]" class="btn btn-soft-success rounded-pill mb-1" style="font-size: x-large;">@TempData["LdapDisplayName"]</a>
 *@
    @*                        <a class="btn btn-soft-danger avatar-lg" href="#!">
                                <i class="ti ti-brand-google-filled fs-24">
                                </i>
                            </a>*@
                        @* </div>
                        <p class="fs-13 fw-semibold">
                            Or Login With Username
                        </p> *@
                        <form method="post" class="text-start mb-3">
                            <div class="mb-3">
                                <label class="form-label" for="example-email">
                                    Username
                                </label>
                                <input class="form-control" id="example-email" asp-for="@Model.UserName" placeholder="Enter your username" type="text" required=""/>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                                <div class="invalid-feedback">
                                    Please enter UserName.
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="example-password">
                                    Password
                                </label>
                                <input class="form-control" id="example-password" asp-for="@Model.Password" placeholder="Enter your password" type="password" required=""/>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                                <div class="invalid-feedback">
                                    Please enter Password.
                                </div>
                            </div>
                           <div class="d-flex justify-content-between mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" id="checkbox-signin" type="checkbox" />
                                    <label class="form-check-label" for="checkbox-signin">
                                        Remember me
                                    </label>
                                </div>
                                <a class="text-muted border-bottom border-dashed" href="auth-recoverpw.html">
                                    Forget Password
                                </a>
                            </div>
                            <div class="d-grid">
                                <button class="btn btn-primary" type="submit">
                                    Login
                                </button>
                            </div>
                        </form>
                    
                        <p class="mt-auto mb-0">
                            <div class="text-center text-md-start">
                                <div class="container" style="text-align:center;color:midnightblue;font-weight:bold;text-shadow:2px 2px white">
                                    Developed by Software Development Cell, MAC, New Delhi.<sup>&copy;</sup>
                                    <br />This site is best viewed in Google Chrome
                                </div>
                            </div>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @{
            <partial name="_Notification" />
            <partial name="_ValidationScriptsPartial" />
        }
        <!-- Vendor js -->
        <script src="../assets/vendor.min.js">
        </script>
        <!-- App js -->
        <script src="../assets/app.js">
        </script>
        <!-- SweetAlert JavaScript -->
        <script src="~/lib/toastr/toastr.min.js"></script>
        <script src="~/vendor/sweetalert2/sweetalert2.min.js"></script>
    </body>
</html>
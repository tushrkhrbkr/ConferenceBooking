@{
}

@{
    Layout = null;
    ViewData["Title"] = "Password Reset Successful";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Password Reset Successful | CONVENE</title>

    <link href="~/assets/vendor.min.css" rel="stylesheet" />
    <link href="~/assets/app.min.css" rel="stylesheet" />
    <link href="~/assets/icons.min.css" rel="stylesheet" />
</head>

<body>
    <div class="auth-bg d-flex min-vh-100 justify-content-center align-items-center">

        <div class="col-xl-4 col-lg-5 col-md-6 m-3">

            <div class="card text-center p-4">

                <a asp-controller="AuthLogin"
                   asp-action="Login"
                   class="auth-brand mb-3">

                    <img src="~/images/ConveneDarkLogoIndia.png"
                         height="90"
                         alt="CONVENE" />
                </a>

                <div class="mb-3">
                    <div class="avatar-xl mx-auto">
                        <span class="avatar-title bg-success-subtle text-success rounded-circle">
                            <i class="ti ti-check fs-1"></i>
                        </span>
                    </div>
                </div>

                <h3 class="fw-semibold text-success mb-2">
                    Password Reset Successful!
                </h3>

                <p class="text-muted mb-4">
                    Your CONVENE account password has been
                    successfully reset.
                </p>

                <div class="alert alert-success text-start">
                    <i class="ti ti-shield-check me-1"></i>

                    You can now sign in using your new password.
                </div>

                <div class="d-grid mt-3">
                    <a asp-controller="AuthLogin"
                       asp-action="Login"
                       class="btn btn-primary">

                        <i class="ti ti-login me-1"></i>
                        Go to Login
                    </a>
                </div>

                <p class="text-muted fs-13 mt-4 mb-0">
                    For security reasons, your previous password
                    can no longer be used.
                </p>

            </div>

        </div>

    </div>

    <script src="~/assets/vendor.min.js"></script>
    <script src="~/assets/app.js"></script>

</body>
</html>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
    var captchaId = Guid.NewGuid().ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password | CONVENE</title>

    <link href="~/assets/vendor.min.css" rel="stylesheet" />
    <link href="~/assets/app.min.css" rel="stylesheet" />
    <link href="~/assets/icons.min.css" rel="stylesheet" />
</head>

<body>
    <div class="auth-bg d-flex min-vh-100 justify-content-center align-items-center">
        <div class="col-xl-4 col-lg-5 col-md-6 m-3">
            <div class="card text-center p-4">

                <a asp-controller="AuthLogin" asp-action="Login"
                   class="auth-brand mb-3">
                    <img src="~/images/ConveneDarkLogoIndia.png"
                         height="90" alt="CONVENE" />
                </a>

                <h3 class="fw-semibold mb-2">Forgot Password?</h3>

                <p class="text-muted">
                    Enter your registered email address to request a password
                    reset OTP.
                </p>

                <form asp-action="ForgotPassword"
                      method="post"
                      class="text-start">

                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    @if (ViewBag.Status != null)
                    {
                        <input type="hidden"
                               id="responseStatus"
                               value="@ViewBag.Status" />
                    }

                    <div class="mb-3">
                        <label class="form-label" for="email">
                            Registered Email Address
                        </label>

                        <input type="email"
                               id="email"
                               name="email"
                               value="@ViewBag.Email"
                               class="form-control"
                               placeholder="Enter registered email"
                               required
                               maxlength="256"
                               autocomplete="email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Security Verification</label>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img id="captchaImage"
                                 src="@Url.Action("CaptchaImage", "AuthLogin",
                                           new { challengeId = captchaId })"
                                 alt="CAPTCHA"
                                 width="220"
                                 height="65"
                                 class="border rounded" />

                            <input type="hidden"
                                   name="captchaId"
                                   id="captchaId"
                                   value="@captchaId" />

                            <button type="button"
                                    class="btn btn-light border"
                                    onclick="refreshCaptcha()"
                                    title="Refresh CAPTCHA">
                                <i class="ti ti-refresh"></i>
                            </button>
                        </div>

                        <input type="text"
                               name="captcha"
                               id="captcha"
                               class="form-control"
                               placeholder="Enter the characters shown above"
                               autocomplete="off"
                               maxlength="6"
                               required />

                        <small class="text-muted">
                            Enter the six characters displayed in the image.
                        </small>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Send OTP
                        </button>
                    </div>
                </form>
                <div class="mt-3 text-muted small">
                    <i class="ti ti-info-circle me-1"></i>
                    If your account is inactive or registration is pending,
                    please contact the CONVENE Administrator.
                </div>
                <div class="mt-3">
                    <a asp-controller="AuthLogin" asp-action="Login">
                        Back to Login
                    </a>
                </div>

            </div>
        </div>
    </div>

    <script src="~/assets/vendor.min.js"></script>
    <script src="~/assets/app.js"></script>
    <script>
        function refreshCaptcha() {
            const image = document.getElementById("captchaImage");
            const captchaInput = document.getElementById("captcha");
            const captchaIdInput = document.getElementById("captchaId");

            const newId = crypto.randomUUID();

            captchaIdInput.value = newId;

            image.src =
                '@Url.Action("CaptchaImage", "AuthLogin")'
                + '?challengeId=' + encodeURIComponent(newId)
                + '&t=' + new Date().getTime();

            captchaInput.value = "";
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>